---
import { SOCIALS } from "@/constants";
import LinkButton from "./LinkButton.astro";
---

<div class="flex flex-wrap items-center gap-2">
  {
    SOCIALS.map(social => (
      <LinkButton
        href={social.href}
        class="p-1 hover:rotate-6"
        title={social.linkTitle}
      >
        <social.icon class="inline-block size-5 fill-transparent stroke-current stroke-2 opacity-85 group-hover:fill-transparent" />
        <span class="sr-only">{social.linkTitle}</span>
      </LinkButton>
    ))
  }
</div>
